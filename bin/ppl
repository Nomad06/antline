#!/bin/sh
# Resolve the checkout from this script's own location, so `ppl` works from
# any directory once bin/ is on PATH. The imported package finds its own
# assets, PPL_HOME is the data root (default ~/.ppl).
checkout="$(cd "$(dirname "$0")/.." && pwd)"
# ppl needs Python 3.11 (tomllib), and an older python3 used to answer with a
# traceback. The check is kept to syntax any python3 parses.
python3 -c 'import sys
v = sys.version_info
sys.exit(0 if v >= (3, 11) else "ppl needs Python 3.11 or newer, but python3 on PATH is %d.%d.%d." % tuple(v[:3]))' || exit 2
exec env PYTHONPATH="$checkout${PYTHONPATH:+:$PYTHONPATH}" python3 -m ppl "$@"
